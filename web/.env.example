# Pargot.ai — web app environment
# Copy to `.env.local` and fill in. Only the REQUIRED block is needed to run locally.

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# LiveKit (free tier at https://cloud.livekit.io → Settings → Keys).
# Must match the values in agent/.env.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>

# Google AI Studio key (https://aistudio.google.com/apikey) — powers the coach
# panel and the end-of-interview summary.
GOOGLE_API_KEY=<your_google_ai_key>

# ─── OPTIONAL ────────────────────────────────────────────────────────────────
# Groq key (https://console.groq.com/keys). When set, the coach tries
# openai/gpt-oss-120b on Groq first (fast), falling back to Gemini.
GROQ_API_KEY=

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch).
# Leave blank for automatic dispatch.
AGENT_NAME=

# ─── AUTH MODE (optional, off by default) ────────────────────────────────────
# Leave this false to run with no sign-in, no database, no limits.
# Set to `true` to enable Google sign-in + interview history + a daily quota;
# then every variable below becomes required.
NEXT_PUBLIC_AUTH_ENABLED=false

# Generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Postgres connection string (Neon pooled URL recommended). Then run `pnpm db:push`.
DATABASE_URL=
# Free interviews per user per UTC day (server enforces; NEXT_PUBLIC_ copy is display-only).
DAILY_INTERVIEW_LIMIT=3
NEXT_PUBLIC_DAILY_INTERVIEW_LIMIT=3

# ─── Internal (LiveKit sandbox; leave blank) ─────────────────────────────────
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
